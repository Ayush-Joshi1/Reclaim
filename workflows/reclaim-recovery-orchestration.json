    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction errorOut(message, paymentId, eventId, backendResponse) {\n  return [{\n    json: {\n      ok: false,\n      action: \"ERROR\",\n      decision_action: null,\n      valid_action: false,\n      error_message: message,\n      status: \"error\",\n      payment_id: paymentId != null ? paymentId : null,\n      event_id: eventId != null ? eventId : null,\n      backend_response: backendResponse != null ? backendResponse : null\n    }\n  }];\n}\n\nfunction unwrap(value) {\n  if (value == null) return null;\n\n  if (typeof value === \"string\") {\n    try {\n      const parsed = JSON.parse(value);\n      return unwrap(parsed);\n    } catch {\n      return value;\n    }\n  }\n\n  if (typeof value !== \"object\" || Array.isArray(value)) return null;\n\n  if (value.action != null) return value.action;\n  if (value.decision_action != null) return value.decision_action;\n\n  if (value.body != null) return unwrap(value.body);\n  if (value.data != null) return unwrap(value.data);\n  if (value.decision != null) return unwrap(value.decision);\n  if (value.result != null) return unwrap(value.result);\n\n  return null;\n}\n\nif (!items.length) {\n  return errorOut(\"Reclaim returned no response.\", null, null, null);\n}\n\nlet data = items[0].json;\nif (data && data.error) {\n  const err = data.error;\n  const httpCode = err.httpCode || (err.context && err.context.httpCode) || null;\n  const msg = err.message || err.description || String(err);\n  const prefix = String(httpCode) === \"422\" ? \"Reclaim API validation failed: \" : \"Reclaim API request failed: \";\n  return errorOut(prefix + msg, null, null, { error: err });\n}\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) {\n    return errorOut(\"Reclaim returned invalid JSON.\", null, null, null);\n  }\n}\nif (!data || typeof data !== \"object\") {\n  return errorOut(\"Reclaim returned an empty response.\", null, null, null);\n}\n\nconst paymentId = data.payment_id != null ? data.payment_id\n  : (data.payment && data.payment.payment_id != null ? data.payment.payment_id\n  : (data.decision && data.decision.payment_id != null ? data.decision.payment_id : null));\nconst eventId = data.event_id != null ? data.event_id\n  : (data.decision && data.decision.event_id != null ? data.decision.event_id : null);\n\nconst allowed = [\"RETRY\", \"PAYMENT_LINK\", \"REMINDER\", \"ESCALATE\", \"STOP\"];\nlet apiAction = unwrap(data);\nif (typeof apiAction === \"string\") apiAction = apiAction.trim().toUpperCase();\nif (!apiAction) {\n  return errorOut(\"Recovery action missing from Reclaim response.\", paymentId, eventId, data);\n}\nif (!allowed.includes(apiAction)) {\n  return errorOut(\"Unsupported recovery action: \" + apiAction, paymentId, eventId, data);\n}\n\nreturn [{\n  json: {\n    ok: true,\n    action: apiAction,\n    decision_action: apiAction,\n    valid_action: true,\n    status: \"success\",\n    payment_id: paymentId,\n    event_id: eventId,\n    backend_response: data,\n    error_message: null,\n    message: \"Validated recovery action: \" + apiAction + \".\"\n  }\n}];"
      },
