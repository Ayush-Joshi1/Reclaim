    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\n\nlet r = item;\n\n// Handle webhook body\nlet b = r?.body ?? r;\n\nif (typeof b === \"string\") {\n  try {\n    b = JSON.parse(b);\n  } catch {\n    b = {};\n  }\n}\n\nif (!b || typeof b !== \"object\" || Array.isArray(b)) {\n  b = {};\n}\n\n// Razorpay payment entity\nconst entity =\n  b?.payload?.payment?.entity ||\n  b?.payment?.entity ||\n  {};\n\n// Basic Razorpay fields\nconst paymentId =\n  entity?.id ||\n  b?.payment_id ||\n  null;\n\nconst eventTypeRaw =\n  b?.event ||\n  b?.event_type ||\n  \"payment.failed\";\n\nconst eventType =\n  eventTypeRaw === \"payment.failed\"\n    ? \"payment_failed\"\n    : eventTypeRaw;\n\nconst createdAt =\n  b?.created_at ||\n  entity?.created_at ||\n  Math.floor(Date.now() / 1000);\n\nconst eventId =\n  b?.event_id ||\n  b?.id ||\n  (paymentId\n    ? `rzp_${paymentId}_${createdAt}`\n    : `rzp_event_${Date.now()}`);\n\nconst amount =\n  entity?.amount != null\n    ? Number(entity.amount) / 100\n    : null;\n\nconst currency =\n  entity?.currency ||\n  \"INR\";\n\nconst method =\n  entity?.method ||\n  null;\n\nconst status =\n  entity?.status ||\n  \"failed\";\n\nconst failureReason =\n  entity?.error_reason ||\n  entity?.error_description ||\n  entity?.error_source ||\n  \"payment_failed\";\n\nconst customerId =\n  entity?.email ||\n  entity?.contact ||\n  paymentId ||\n  null;\n\nconst failedAt =\n  new Date(Number(createdAt) * 1000).toISOString();\n\n\n// Final payload expected by Reclaim API\nconst api_payload = {\n  event_id: String(eventId),\n\n  event_type: eventType,\n\n  timestamp: failedAt,\n\n  source: \"razorpay\",\n\n  recovery_attempt_count: 0,\n\n  payment_id: paymentId,\n\n  payment: {\n    payment_id: paymentId,\n    amount: amount,\n    currency: currency,\n    status: status,\n    payment_method: method,\n    failure_reason: failureReason,\n    failed_at: failedAt,\n    time_since_failure_hours: 0\n  },\n\n  customer: {\n    customer_id: String(customerId || paymentId || \"unknown\"),\n    notification_count: 0,\n    customer_age_days: 0,\n    previous_successful_payments: 0,\n    previous_failed_payments: 1,\n    previous_recovery_attempts: 0,\n    customer_lifetime_value: amount || 0,\n    average_previous_payment: amount || 0,\n    recent_payment_frequency: 1\n  }\n};\n\n\n// Validation\nconst errors = [];\n\nif (!api_payload.event_id) {\n  errors.push(\"Missing event_id\");\n}\n\nif (!api_payload.payment_id) {\n  errors.push(\"Missing payment_id\");\n}\n\nif (api_payload.event_type !== \"payment_failed\") {\n  errors.push(\"Invalid event_type\");\n}\n\nif (\n  api_payload.payment.amount === null ||\n  api_payload.payment.amount === undefined\n) {\n  errors.push(\"Missing payment amount\");\n}\n\nif (!api_payload.payment.currency) {\n  errors.push(\"Missing currency\");\n}\n\nif (!api_payload.payment.payment_method) {\n  errors.push(\"Missing payment method\");\n}\n\nif (!api_payload.customer.customer_id) {\n  errors.push(\"Missing customer_id\");\n}\n\n\n// Output\nreturn [\n  {\n    json: {\n      valid: errors.length === 0,\n\n      error_message:\n        errors.length > 0\n          ? errors.join(\"; \")\n          : null,\n\n      event_id: api_payload.event_id,\n\n      payment_id: api_payload.payment_id,\n\n      api_payload\n    }\n  }\n];"
      },
